{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alphonse Desktop",
  "version": "0.1.0",
  "identifier": "local.alphonse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alphonse Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;" }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/alphonse-daemon"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
