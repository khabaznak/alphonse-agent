# Task Metadata
- Task ID: {{ task.task_id or "" }}
- Message ID: {{ task.message_id or "" }}
- User: {{ task.user or "" }}
- Project ID: {{ task.project_id }}
- Tag: {{ task.tag }}
- Correlation ID: {{ task.correlation_id }}
- Status: {{ task.status }}
- PDCA Cycle Count: {{ task.pdca_cycle_count }}

# Goal
{{ task.goal or "- (none)" }}

# Attachments
{% set attachments = task.metadata.get("attachments", []) if task.metadata else [] %}
{% if attachments %}
{% for attachment in attachments %}
- Asset ID: {{ attachment.get("asset_id", "") }} | Name: {{ attachment.get("filename", "") }} | MIME: {{ attachment.get("mime_type", "") }} | Kind: {{ attachment.get("kind", "") }} | Status: {{ attachment.get("ingestion_status", "") }} | Caption: {{ attachment.get("caption", "") }}
{% endfor %}
{% else %}
- (none)
{% endif %}

# Recent Conversation
{{ task.recent_conversation_md or "- (none)" }}

# Conversation History
{{ task.conversation_history_md or "- (none)" }}

# Facts
{{ task.facts_md or "- (none)" }}

# Plan JSON
{{ task.plan_json or "- (none)" }}

# Required User Confirmation
{% set pending_confirmation = task.metadata.get("pending_silent_bash_confirmation") if task.metadata else none %}
{% if pending_confirmation %}
- A successful Bash action produced no user-visible output. Call `native.respond` next with a concise, contextual confirmation before completing this task.
- Completed Bash action: {{ pending_confirmation.get("internal_state", "") or pending_confirmation.get("command", "") }}
{% else %}
- (none)
{% endif %}

# Acceptance Criteria
{{ task.acceptance_criteria_md or "- (none)" }}

# Updates
{{ task.updates_md or "- (none)" }}

# Memory Facts
{{ task.memory_facts_md or "- (none)" }}

# Check Result
- Verdict: {{ task.check_verdict or "" }}
- Reason: {{ task.check_reason }}
- Confidence: {{ task.check_confidence }}
- Evidence Refs: {{ (task.check_evidence_refs or []) | join(", ") }}
- New Message Count: {{ task.check_new_message_count }}

# Outcome
{{ task.outcome if task.outcome is not none else "- (none)" }}
